# ============================================================
# Jan Aushadhi Ecommerce - Environment Variables
# Copy this file to `.env` and fill in real values.
# Backend: Neon Postgres (project: sweet-silence-15535482)
# ============================================================

# ---- Site ----
SITE_URL="https://janaushadhi.pages.dev"
PUBLIC_APP_URL="https://janaushadhi.pages.dev"

# ---- Neon Postgres ----
# Run: neon connection-string --project-id sweet-silence-15535482
# Or:  neon env pull  (re-generates from Neon servers, no secrets transported)
DATABASE_URL="postgresql://neondb_owner:...@....neon.tech/neondb?sslmode=require"

# ---- Razorpay (direct, no managed-payments proxy) ----
# Key ID is public (safe for browser). Key secret is server-only.
PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# "true" => test environment; "false" => live.
PUBLIC_RAZORPAY_TEST_MODE="true"

# ---- Neon Managed Better Auth (oriz-accounts hub) ----
# Enable Managed Auth in the Neon Console for project autumn-recipe-04450972.
# NEON_AUTH_BASE_URL: server-side Better Auth base URL (Console → Auth → Auth URL).
# PUBLIC_NEON_AUTH_BASE_URL: SAME url, PUBLIC_-prefixed so Vite exposes it to the
#   browser client (astro client components read this; bare var is server-only).
# NEON_AUTH_COOKIE_SECRET: random 32-char secret for signing session cookies.
NEON_AUTH_BASE_URL="https://ep-rough-bar-ax3guohy.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth"
PUBLIC_NEON_AUTH_BASE_URL="https://ep-rough-bar-ax3guohy.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="change-me-32-chars-minimum-secret"

