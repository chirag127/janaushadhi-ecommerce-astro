# ============================================================
# Jan Aushadhi Ecommerce - Environment Variables
# Copy this file to `.env` and fill in real values.
# Backend: InsForge (project: janaushadhi-shared)
# ============================================================

# ---- Site ----
SITE_URL="https://janaushadhi.pages.dev"
PUBLIC_APP_URL="https://janaushadhi.pages.dev"

# ---- InsForge (public: safe for browser) ----
# URL is the oss_host from .insforge/project.json
# Anon key:  npx @insforge/cli secrets get ANON_KEY
PUBLIC_INSFORGE_URL="https://ht574p3t.us-east.insforge.app"
PUBLIC_INSFORGE_ANON_KEY="anon_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- InsForge (server-only: full admin, bypasses RLS) ----
# API key from .insforge/project.json (api_key). NEVER expose to browser.
INSFORGE_URL="https://ht574p3t.us-east.insforge.app"
INSFORGE_API_KEY="ik_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Razorpay via InsForge managed payments ----
# Master switch. "true" => TEST environment used for createOrder/verifyOrder.
# "false" => LIVE environment used.
# Keys themselves are NOT stored here — configure them in InsForge with:
#   npx @insforge/cli payments razorpay config set --environment test \
#     --key-id rzp_test_xxx --key-secret xxx
#   npx @insforge/cli payments razorpay config set --environment live \
#     --key-id rzp_live_xxx --key-secret xxx
PUBLIC_RAZORPAY_TEST_MODE="true"
