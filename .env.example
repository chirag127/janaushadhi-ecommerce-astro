# ============================================================
# Jan Aushadhi Ecommerce - Environment Variables
# Copy this file to `.env` and fill in real values.
# Backend: Neon Postgres (project: sweet-silence-15535482)
# ============================================================

# ---- Site ----
SITE_URL="https://janaushadhi.pages.dev"
PUBLIC_APP_URL="https://janaushadhi.pages.dev"

# ---- Neon Postgres ----
# Run: neon connection-string --project-id sweet-silence-15535482
# Or:  neon env pull  (re-generates from Neon servers, no secrets transported)
DATABASE_URL="postgresql://neondb_owner:...@....neon.tech/neondb?sslmode=require"

# ---- Razorpay (direct, no managed-payments proxy) ----
# Key ID is public (safe for browser). Key secret is server-only.
PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# "true" => test environment; "false" => live.
PUBLIC_RAZORPAY_TEST_MODE="true"
