---
import { useTranslations, type Locale } from "@lib/i18n";
const locale = (Astro.locals.locale ?? "en") as Locale;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
  <div class="container-page grid gap-8 py-12 md:grid-cols-4">
    <div>
      <div class="mb-3 flex items-center gap-2">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white font-bold">JA</span>
        <span class="font-bold text-slate-900 dark:text-white">{t("site.name")}</span>
      </div>
      <p class="text-sm text-slate-500">{t("site.tagline")}</p>
    </div>
    <div>
      <h4 class="mb-3 text-sm font-semibold text-slate-900 dark:text-white">Shop</h4>
      <ul class="space-y-2 text-sm text-slate-500">
        <li><a href="/products" class="hover:text-brand-600">{t("nav.products")}</a></li>
        <li><a href="/categories" class="hover:text-brand-600">{t("nav.categories")}</a></li>
        <li><a href="/products?sort=price_asc" class="hover:text-brand-600">Best Prices</a></li>
      </ul>
    </div>
    <div>
      <h4 class="mb-3 text-sm font-semibold text-slate-900 dark:text-white">Company</h4>
      <ul class="space-y-2 text-sm text-slate-500">
        <li><a href="/about" class="hover:text-brand-600">{t("footer.about")}</a></li>
        <li><a href="/blog" class="hover:text-brand-600">{t("nav.blog")}</a></li>
        <li><a href="/contact" class="hover:text-brand-600">{t("nav.contact")}</a></li>
        <li><a href="/faq" class="hover:text-brand-600">{t("nav.faq")}</a></li>
      </ul>
    </div>
    <div>
      <h4 class="mb-3 text-sm font-semibold text-slate-900 dark:text-white">Legal</h4>
      <ul class="space-y-2 text-sm text-slate-500">
        <li><a href="/privacy" class="hover:text-brand-600">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-brand-600">Terms of Service</a></li>
        <li><a href="/shipping" class="hover:text-brand-600">Shipping & Returns</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200 py-4 dark:border-slate-800">
    <p class="container-page text-center text-xs text-slate-400">
      &copy; {year} {t("site.name")}. {t("footer.rights")}
    </p>
  </div>
</footer>
