---
import { useTranslations, type Locale } from "@lib/i18n";
import ThemeToggle from "./react/ThemeToggle.tsx";
import PrefsSwitcher from "./react/PrefsSwitcher.tsx";
import { CartBadge, WishlistBadge } from "./react/HeaderBadges.tsx";

const locale = (Astro.locals.locale ?? "en") as Locale;
const t = useTranslations(locale);
const user = Astro.locals.user;
const isAdmin = Astro.locals.isAdmin;

const navLinks = [
  { href: "/products", label: t("nav.products") },
  { href: "/categories", label: t("nav.categories") },
  { href: "/blog", label: t("nav.blog") },
  { href: "/faq", label: t("nav.faq") },
  { href: "/contact", label: t("nav.contact") },
];
---

<header
  class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-950/95"
>
  <div class="bg-brand-700 text-white">
    <div class="container-page flex h-8 items-center justify-between text-xs">
      <span>{t("site.tagline")}</span>
      <div class="hidden sm:block"><PrefsSwitcher client:idle /></div>
    </div>
  </div>

  <div class="container-page flex h-16 items-center gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-brand-600 text-white font-bold">JA</span>
      <span class="hidden text-lg font-bold text-slate-900 dark:text-white sm:inline">
        {t("site.name")}
      </span>
    </a>

    <form action="/search" method="get" class="relative hidden flex-1 md:block">
      <input
        type="search"
        name="q"
        placeholder={t("nav.search")}
        class="input pl-10"
        aria-label={t("common.search")}
      />
      <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
      </svg>
    </form>

    <nav class="ml-auto hidden items-center gap-1 lg:flex">
      {navLinks.map((l) => (
        <a href={l.href} class="btn-ghost text-sm">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-1">
      <ThemeToggle client:idle />

      <a href="/wishlist" class="btn-ghost relative !px-2" aria-label={t("nav.wishlist")}>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
        <WishlistBadge client:idle />
      </a>

      <a href="/cart" class="btn-ghost relative !px-2" aria-label={t("nav.cart")}>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
        </svg>
        <CartBadge client:idle />
      </a>

      {
        user ? (
          <div class="group relative">
            <button class="btn-ghost !px-2" aria-label={t("nav.account")}>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a7.5 7.5 0 0 1 15 0" />
              </svg>
            </button>
            <div class="invisible absolute right-0 top-full z-50 w-48 rounded-lg border border-slate-200 bg-white py-1 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100 dark:border-slate-800 dark:bg-slate-900">
              <a href="/account" class="block px-4 py-2 text-sm hover:bg-slate-50 dark:hover:bg-slate-800">{t("nav.account")}</a>
              <a href="/orders" class="block px-4 py-2 text-sm hover:bg-slate-50 dark:hover:bg-slate-800">{t("nav.orders")}</a>
              {isAdmin && (
                <a href="/admin" class="block px-4 py-2 text-sm font-medium text-brand-600 hover:bg-slate-50 dark:hover:bg-slate-800">{t("nav.admin")}</a>
              )}
              <form method="post" action="/api/auth/signout">
                <button type="submit" class="block w-full px-4 py-2 text-left text-sm text-rose-600 hover:bg-slate-50 dark:hover:bg-slate-800">{t("nav.logout")}</button>
              </form>
            </div>
          </div>
        ) : (
          <a href="/login" class="btn-primary ml-1 hidden text-sm sm:inline-flex">
            {t("nav.login")}
          </a>
        )
      }
    </div>
  </div>

  <div class="border-t border-slate-100 px-4 py-2 md:hidden dark:border-slate-800">
    <form action="/search" method="get" class="relative">
      <input type="search" name="q" placeholder={t("nav.search")} class="input pl-10" aria-label={t("common.search")} />
      <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
      </svg>
    </form>
  </div>
</header>
