---
import Layout from "@layouts/Layout.astro";
export const prerender = false;
---
<Layout title="Page Not Found" noindex>
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">Page Not Found</h1>
    <p class="mt-2 text-slate-500">The page you are looking for doesn't exist or has moved.</p>
    <a href="/" class="btn-primary mt-6">Back to Home</a>
  </div>
</Layout>
