---
import Layout from "@layouts/Layout.astro";
import ProductCard from "@components/ProductCard.astro";
import { createInsForgeServer } from "@lib/insforge/server";
import { getFeaturedProducts, getCategories, getProducts } from "@lib/queries";
import { useTranslations, type Locale } from "@lib/i18n";
import type { Currency } from "@lib/currency";

export const prerender = false;

const locale = (Astro.locals.locale ?? "en") as Locale;
const currency = (Astro.locals.currency ?? "INR") as Currency;
const t = useTranslations(locale);

const insforge = createInsForgeServer(Astro.cookies, Astro.locals);

let featured = await getFeaturedProducts(insforge, 8);
if (featured.length === 0) {
  // fallback to newest products if none marked featured
  const { products } = await getProducts(insforge, { page: 1 });
  featured = products.slice(0, 8);
}
const categories = (await getCategories(insforge)).slice(0, 12);

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "Jan Aushadhi Store",
  description: t("site.tagline"),
  url: Astro.site?.toString(),
};

const perks = [
  {
    title: "Up to 90% Savings",
    body: "Generic medicines at a fraction of branded prices.",
    icon: "M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33",
  },
  {
    title: "Certified Quality",
    body: "WHO-GMP certified, government-approved medicines.",
    icon: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
  {
    title: "Fast Delivery",
    body: "Free shipping on orders above ₹500 across India.",
    icon: "M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-8.25",
  },
  {
    title: "Secure Payments",
    body: "Razorpay-powered, 100% secure transactions.",
    icon: "M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z",
  },
];
---

<Layout
  title={`${t("site.name")} — ${t("site.tagline")}`}
  jsonLd={orgJsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-600 to-brand-800 text-white">
    <div class="container-page grid items-center gap-8 py-16 md:grid-cols-2 md:py-24">
      <div class="animate-fade-in">
        <span class="badge mb-4 bg-white/15 text-white">
          Government-approved generic medicines
        </span>
        <h1 class="mb-4 text-4xl font-extrabold leading-tight md:text-5xl">
          {t("home.hero.title")}
        </h1>
        <p class="mb-6 max-w-lg text-lg text-brand-50">
          {t("home.hero.subtitle")}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/products" class="btn bg-white text-brand-700 hover:bg-brand-50">
            {t("home.hero.cta")}
          </a>
          <a href="/categories" class="btn border border-white/40 text-white hover:bg-white/10">
            {t("nav.categories")}
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        <div class="grid grid-cols-2 gap-4">
          {
            perks.slice(0, 4).map((p) => (
              <div class="rounded-xl bg-white/10 p-5 backdrop-blur">
                <svg xmlns="http://www.w3.org/2000/svg" class="mb-2 h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                </svg>
                <p class="text-sm font-semibold">{p.title}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="container-page py-12">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        {t("home.categories")}
      </h2>
      <a href="/categories" class="link text-sm">{t("common.viewAll")}</a>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {
        categories.map((c) => (
          <a href={`/categories/${c.slug}`} class="card flex flex-col items-center gap-2 p-4 text-center transition-shadow hover:shadow-md">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-brand-50 text-brand-600 dark:bg-brand-950">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25v-4.5m0 0a2.25 2.25 0 0 0-2.25 2.25v.75m4.5-3a2.25 2.25 0 0 1 2.25 2.25v.75M9.75 3.104c.251.023.501.05.75.082m-.75-.082a24.301 24.301 0 0 0-4.5.532" />
              </svg>
            </span>
            <span class="line-clamp-2 text-xs font-medium text-slate-700 dark:text-slate-200">
              {c.name}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured products -->
  <section class="container-page py-6">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        {t("home.featured")}
      </h2>
      <a href="/products" class="link text-sm">{t("common.viewAll")}</a>
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {featured.map((p) => <ProductCard product={p} currency={currency} />)}
    </div>
  </section>

  <!-- Why choose -->
  <section class="bg-slate-50 py-14 dark:bg-slate-900">
    <div class="container-page">
      <h2 class="mb-8 text-center text-2xl font-bold text-slate-900 dark:text-white">
        {t("home.why.title")}
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          perks.map((p) => (
            <div class="card p-6">
              <span class="mb-3 grid h-11 w-11 place-items-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-950">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                </svg>
              </span>
              <h3 class="mb-1 font-semibold text-slate-900 dark:text-white">{p.title}</h3>
              <p class="text-sm text-slate-500">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
