---
import Layout from "@layouts/Layout.astro";
import AuthForm from "@components/react/AuthForm.tsx";
import { useTranslations, type Locale } from "@lib/i18n";

export const prerender = false;

if (Astro.locals.user) return Astro.redirect("/account");
const locale = (Astro.locals.locale ?? "en") as Locale;
const t = useTranslations(locale);
const next = new URL(Astro.request.url).searchParams.get("next") ?? "/";
---

<Layout title={t("auth.login.title")} noindex hideChrome={false}>
  <div class="container-page flex min-h-[70vh] items-center justify-center py-12">
    <div class="card w-full max-w-md p-8">
      <a href="/" class="mb-6 flex items-center justify-center gap-2">
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-600 text-white font-bold">JA</span>
      </a>
      <h1 class="mb-6 text-center text-2xl font-bold text-slate-900 dark:text-white">{t("auth.login.title")}</h1>
      <AuthForm client:load mode="login" next={next} />
      <p class="mt-3 text-right text-sm">
        <a href="/forgot-password" class="link">Forgot password?</a>
      </p>
      <p class="mt-4 text-center text-sm text-slate-500">
        {t("auth.noAccount")}{" "}
        <a href={`/register${next !== "/" ? `?next=${encodeURIComponent(next)}` : ""}`} class="link">{t("nav.register")}</a>
      </p>
    </div>
  </div>
</Layout>
