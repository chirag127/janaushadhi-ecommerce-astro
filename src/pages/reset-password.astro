---
import Layout from "@layouts/Layout.astro";
import ResetPasswordForm from "@components/react/ResetPasswordForm.tsx";

export const prerender = false;
---

<Layout title="Reset Password" noindex>
  <div class="container-page flex min-h-[70vh] items-center justify-center py-12">
    <div class="card w-full max-w-md p-8">
      <a href="/" class="mb-6 flex items-center justify-center gap-2">
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-600 text-white font-bold">JA</span>
      </a>
      <h1 class="mb-2 text-center text-2xl font-bold text-slate-900 dark:text-white">Reset Password</h1>
      <p class="mb-6 text-center text-sm text-slate-500">
        Enter your new password below.
      </p>
      <ResetPasswordForm client:load />
    </div>
  </div>
</Layout>
